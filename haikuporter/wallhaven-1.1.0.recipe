SUMMARY="Browse and apply wallpapers from wallhaven.cc"
DESCRIPTION="An unofficial wallpaper browser with previews and original downloads. \
Browse saved images offline and set the desktop background on the current, \
a selected, or all workspaces. \
The interface supports English and Chinese."
HOMEPAGE="https://github.com/lhfchym/wallhaven-haiku"
COPYRIGHT="2026 lhfchym"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://github.com/lhfchym/wallhaven-haiku/releases/download/v1.1.0/wallhaven-1.1.0.tar.gz"
CHECKSUM_SHA256="d56f833625e4b038adfc8b02bdac37b904b1afcbd1b19cbe400b7343e381bfdd"
SOURCE_FILENAME="wallhaven-1.1.0.tar.gz"
SOURCE_DIR="wallhaven-haiku/Haiku"

ARCHITECTURES="x86_64"

USER_SETTINGS_FILES="settings/Wallhaven directory"

PROVIDES="
	wallhaven = $portVersion
	app:Wallhaven = $portVersion
	"
REQUIRES="
	haiku >= r1~beta6
	lib:libcurl
	lib:libgcc_s
	lib:libstdc++
	"

BUILD_REQUIRES="
	haiku_devel >= r1~beta6
	devel:libcurl
	"
BUILD_PREREQUIRES="
	cmd:g++
	cmd:install
	cmd:ld
	cmd:make
	"

BUILD()
{
	make $jobArgs CXXFLAGS="$CXXFLAGS -O2 -std=c++17 -Wall -Wextra"
}

INSTALL()
{
	make install-staged PREFIX="$prefix"
	addAppDeskbarSymlink "$appsDir/Wallhaven/Wallhaven"
}

TEST()
{
	make test
}
